{
  "name": "fairdrop-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "FairDrop: High-demand anti-bot sale and registration platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=@fairdrop/web run dev",
    "dev:web": "npm --workspace=@fairdrop/web run dev",
    "build:web": "npm --workspace=@fairdrop/web run build",
    "build:shared": "npm --workspace=@fairdrop/shared run build",
    "test:shared": "npm --workspace=@fairdrop/shared run test",
    "test": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^5.0.3"
  }
}